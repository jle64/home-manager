layout {

    focus-ring {
        active-color   "#0284c7"
        inactive-color "#f0faff"
        urgent-color   "#8a3068"
    }

    border {
        active-color   "#0284c7"
        inactive-color "#f0faff"
        urgent-color   "#8a3068"
    }


    tab-indicator {
        active-color   "#0284c7"
        inactive-color "#8bcef1"
        urgent-color   "#8a3068"
    }

    insert-hint {
        color "#0284c780"
    }
}

recent-windows {
    highlight {
        active-color "#0284c7"
        urgent-color "#8a3068"
    }
}
