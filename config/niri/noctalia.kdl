layout {

    focus-ring {
        active-color   "#fbacf8"
        inactive-color "#1e100f"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#fbacf8"
        inactive-color "#1e100f"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#fbacf8"
        inactive-color "#6d2d6f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#fbacf880"
    }
}

recent-windows {
    highlight {
        active-color "#fbacf8"
        urgent-color "#ffb4ab"
    }
}
