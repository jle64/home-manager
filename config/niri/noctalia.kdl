layout {

    focus-ring {
        active-color   "#006783"
        inactive-color "#fbf8ff"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#006783"
        inactive-color "#fbf8ff"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#006783"
        inactive-color "#bce9ff"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00678380"
    }
}

recent-windows {
    highlight {
        active-color "#006783"
        urgent-color "#ba1a1a"
    }
}
