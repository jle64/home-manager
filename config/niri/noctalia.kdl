layout {

    focus-ring {
        active-color   "#ee9de5"
        inactive-color "#291427"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#ee9de5"
        inactive-color "#291427"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#29142770"
    }

    tab-indicator {
        active-color   "#ee9de5"
        inactive-color "#c910b4"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#ee9de580"
    }
}

recent-windows {
    highlight {
        active-color "#ee9de5"
        urgent-color "#fd4663"
    }
}
