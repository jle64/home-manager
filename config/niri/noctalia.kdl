layout {

    focus-ring {
        active-color   "#ffb783"
        inactive-color "#151407"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb783"
        inactive-color "#151407"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb783"
        inactive-color "#713700"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb78380"
    }
}

recent-windows {
    highlight {
        active-color "#ffb783"
        urgent-color "#ffb4ab"
    }
}
