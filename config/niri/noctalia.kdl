layout {

    focus-ring {
        active-color   "#4cdadc"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#4cdadc"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#4cdadc"
        inactive-color "#004f51"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#4cdadc80"
    }
}

recent-windows {
    highlight {
        active-color "#4cdadc"
        urgent-color "#ffb4ab"
    }
}
