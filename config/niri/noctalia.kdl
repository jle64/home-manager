layout {

    focus-ring {
        active-color   "#0e3672"
        inactive-color "#d1e2fa"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#0e3672"
        inactive-color "#d1e2fa"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#0e3672"
        inactive-color "#5e8dd4"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#0e367280"
    }
}

recent-windows {
    highlight {
        active-color "#0e3672"
        urgent-color "#fd4663"
    }
}
