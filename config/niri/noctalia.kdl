layout {

    focus-ring {
        active-color   "#fb5bb6"
        inactive-color "#f0f3f4"
        urgent-color   "#fb5b66"
    }

    border {
        active-color   "#fb5bb6"
        inactive-color "#f0f3f4"
        urgent-color   "#fb5b66"
    }


    tab-indicator {
        active-color   "#fb5bb6"
        inactive-color "#f6bcdd"
        urgent-color   "#fb5b66"
    }

    insert-hint {
        color "#fb5bb680"
    }
}

recent-windows {
    highlight {
        active-color "#fb5bb6"
        urgent-color "#fb5b66"
    }
}
