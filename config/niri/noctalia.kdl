layout {

    focus-ring {
        active-color   "#f754a0"
        inactive-color "#29141e"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#f754a0"
        inactive-color "#29141e"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#29141e70"
    }

    tab-indicator {
        active-color   "#f754a0"
        inactive-color "#990047"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#f754a080"
    }
}

recent-windows {
    highlight {
        active-color "#f754a0"
        urgent-color "#fd4663"
    }
}
