layout {

    focus-ring {
        active-color   "#676ee4"
        inactive-color "#141529"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#676ee4"
        inactive-color "#141529"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#676ee4"
        inactive-color "#141a85"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#676ee480"
    }
}

recent-windows {
    highlight {
        active-color "#676ee4"
        urgent-color "#fd4663"
    }
}
