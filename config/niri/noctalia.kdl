layout {

    focus-ring {
        active-color   "#67bee4"
        inactive-color "#0b2033"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67bee4"
        inactive-color "#0b2033"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#0b203370"
    }

    tab-indicator {
        active-color   "#67bee4"
        inactive-color "#0c668d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67bee480"
    }
}

recent-windows {
    highlight {
        active-color "#67bee4"
        urgent-color "#fd4663"
    }
}
